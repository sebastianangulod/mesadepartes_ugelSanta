DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mesa_de_partes
DB_USERNAME=root
DB_PASSWORD=

APP_NAME="Mesa de Partes UGEL SANTA"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost
APP_KEY=

ARCHIVO_MAX_SIZE=102400
SESION_EXPIRACION=120
INTENTOS_LOGIN=10
PASSWORD_MIN_LENGTH=8

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Mesa de Partes UGEL SANTA"

#Activar Decolecta API
DECOLECTA_API_ENABLED=false
DECOLECTA_API_TOKEN=
DECOLECTA_API_URL=https://api.decolecta.com

PHP_INI_SCAN_DIR=

# Almacenamiento de documentos (PDFs de tramites)
# Por defecto: local, misma carpeta actual. No tocar salvo migracion indicada por TI.
FILESYSTEM_DOCUMENTOS_DISK=documentos
#FILESYSTEM_DOCUMENTOS_DRIVER=local
#FILESYSTEM_DOCUMENTOS_ROOT=
# Para nube S3-compatible (Wasabi/R2/B2/S3): descomentar y completar
#FILESYSTEM_DOCUMENTOS_DRIVER=s3
#FILESYSTEM_DOCUMENTOS_S3_KEY=
#FILESYSTEM_DOCUMENTOS_S3_SECRET=
#FILESYSTEM_DOCUMENTOS_S3_REGION=us-east-1
#FILESYSTEM_DOCUMENTOS_S3_BUCKET=
#FILESYSTEM_DOCUMENTOS_S3_ENDPOINT=

# Google reCAPTCHA v2 (config/services.php)
# Obtener claves en https://www.google.com/recaptcha/admin/create
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_ENABLED=false
